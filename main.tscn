[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="main_script"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="hud_scene"]
[ext_resource type="PackedScene" path="res://ui/debug_overlay.tscn" id="overlay_scene"]
[ext_resource type="Shader" path="res://shaders/palette_limit.gdshader" id="palette_shader"]
[ext_resource type="PackedScene" path="res://ui/dev_console.tscn" id="console_scene"]
[ext_resource type="PackedScene" path="res://ui/scoreboard.tscn" id="scoreboard_scene"]
[ext_resource type="PackedScene" path="res://ui/match_end_screen.tscn" id="match_end_scene"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="pause_menu_scene"]
[ext_resource type="PackedScene" path="res://ui/settings_menu.tscn" id="settings_menu_scene"]
[ext_resource type="PackedScene" path="res://ui/class_menu.tscn" id="class_menu_scene"]

[sub_resource type="ShaderMaterial" id="palette_material"]
shader = ExtResource("palette_shader")

[node name="Main" type="Node"]
script = ExtResource("main_script")

[node name="World" type="SubViewportContainer" parent="."]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
stretch = true
stretch_shrink = 2

[node name="SubViewport" type="SubViewport" parent="World"]
audio_listener_enable_3d = true
size = Vector2i(640, 360)
render_target_update_mode = 4

[node name="PaletteEffect" type="CanvasLayer" parent="World/SubViewport"]
visible = false

[node name="Rect" type="ColorRect" parent="World/SubViewport/PaletteEffect"]
material = SubResource("palette_material")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="HUD" parent="." instance=ExtResource("hud_scene")]

[node name="DebugOverlay" parent="." instance=ExtResource("overlay_scene")]

[node name="Scoreboard" parent="." instance=ExtResource("scoreboard_scene")]

[node name="PauseMenu" parent="." instance=ExtResource("pause_menu_scene")]

[node name="MatchEndScreen" parent="." instance=ExtResource("match_end_scene")]

[node name="SettingsMenu" parent="." instance=ExtResource("settings_menu_scene")]

[node name="ClassMenu" parent="." instance=ExtResource("class_menu_scene")]

[node name="DevConsole" parent="." instance=ExtResource("console_scene")]
