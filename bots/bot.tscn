[gd_scene format=3]

[ext_resource type="PackedScene" path="res://characters/character.tscn" id="character_scene"]
[ext_resource type="PackedScene" path="res://weapons/rifle.tscn" id="rifle_scene"]
[ext_resource type="Script" path="res://bots/bot_controller.gd" id="controller_script"]
[ext_resource type="Script" path="res://bots/bot_senses.gd" id="senses_script"]

[node name="Bot" node_paths=PackedStringArray("weapon") instance=ExtResource("character_scene")]
team = 1
team_color = Color(0.72, 0.22, 0.18, 1)
weapon = NodePath("Head/Weapon")

[node name="Weapon" parent="Head" instance=ExtResource("rifle_scene")]

[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 0.6
target_desired_distance = 0.8
path_height_offset = 0.5
radius = 0.5
height = 2.0

[node name="BotController" type="Node" parent="."]
script = ExtResource("controller_script")

[node name="BotSenses" type="Node" parent="."]
script = ExtResource("senses_script")
