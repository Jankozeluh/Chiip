layout_mode = 2
mouse_filter = 2
theme_type_variation = &"EnemyChip"

[node name="Accent" type="Panel" parent="Page/Logo/Chips"]
custom_minimum_size = Vector2(16, 8)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"AccentChip"

[node name="Items" type="VBoxContainer" parent="Page"]
offset_left = 48.0
