[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="menu_script"]
[ext_resource type="Script" path="res://ui/menu_flight.gd" id="flight_script"]
[ext_resource type="Shader" path="res://shaders/palette_limit.gdshader" id="palette_shader"]
[ext_resource type="PackedScene" path="res://ui/match_setup.tscn" id="setup_scene"]
[ext_resource type="PackedScene" path="res://ui/settings_menu.tscn" id="settings_menu_scene"]
[ext_resource type="Texture2D" path="res://assets/ui/chip.png" id="chip"]
[ext_resource type="PackedScene" path="res://ui/lobby_menu.tscn" id="lobby_scene"]
[ext_resource type="PackedScene" path="res://ui/boot_screen.tscn" id="boot_scene"]

[sub_resource type="ShaderMaterial" id="palette_material"]
shader = ExtResource("palette_shader")

[node name="MainMenu" type="Node"]
script = ExtResource("menu_script")

[node name="World" type="SubViewportContainer" parent="."]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
stretch = true
stretch_shrink = 2

[node name="SubViewport" type="SubViewport" parent="World"]
size = Vector2i(640, 360)
render_target_update_mode = 4

[node name="PaletteEffect" type="CanvasLayer" parent="World/SubViewport"]
visible = false

[node name="Rect" type="ColorRect" parent="World/SubViewport/PaletteEffect"]
material = SubResource("palette_material")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Flight" type="Node3D" parent="World/SubViewport"]
script = ExtResource("flight_script")

[node name="Path" type="Path3D" parent="World/SubViewport/Flight"]

[node name="Follow" type="PathFollow3D" parent="World/SubViewport/Flight/Path"]
rotation_mode = 0

[node name="Camera" type="Camera3D" parent="World/SubViewport/Flight/Path/Follow"]
current = true
fov = 70.0

[node name="Page" type="CanvasLayer" parent="."]

[node name="Side" type="Panel" parent="Page"]
anchors_preset = 9
anchor_bottom = 1.0
offset_right = 448.0
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"SidePanel"

[node name="Logo" type="VBoxContainer" parent="Page"]
offset_left = 64.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 208.0
mouse_filter = 2
theme_type_variation = &"ModeText"

[node name="Title" type="Label" parent="Page/Logo"]
layout_mode = 2
theme_type_variation = &"LogoLabel"
text = "CHIIP"

[node name="Chips" type="HBoxContainer" parent="Page/Logo"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ChipRow"

[node name="Friendly" type="Panel" parent="Page/Logo/Chips"]
custom_minimum_size = Vector2(16, 8)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"FriendlyChip"

[node name="Enemy" type="Panel" parent="Page/Logo/Chips"]
