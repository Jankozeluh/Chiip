[gd_scene format=3]

[ext_resource type="Script" path="res://ui/match_setup.gd" id="setup_script"]
[ext_resource type="Texture2D" path="res://assets/ui/chip.png" id="chip"]

[node name="MatchSetup" type="CanvasLayer"]
layer = 2
visible = false
script = ExtResource("setup_script")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"InkPanel"

[node name="Page" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"PageMargin"

[node name="Column" type="VBoxContainer" parent="Page"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PageColumn"

[node name="Header" type="HBoxContainer" parent="Page/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RowBox"

[node name="Title" type="Label" parent="Page/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
text = "Play"

[node name="Esc" type="Label" parent="Page/Column/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"DimKeyCapLabel"
text = "Esc"

[node name="BackButton" type="Button" parent="Page/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"TextButton"
text = "Back"

[node name="Cards" type="HBoxContainer" parent="Page/Column"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"CardRow"

[node name="Divider" type="HBoxContainer" parent="Page/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RowBox"

[node name="Custom" type="Label" parent="Page/Column/Divider"]
layout_mode = 2
text = "Custom"

[node name="Line" type="HSeparator" parent="Page/Column/Divider"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ModeName" type="Label" parent="Page/Column/Divider"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MuteLabel"
text = "Team Deathmatch"

[node name="Rows" type="GridContainer" parent="Page/Column"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"FormGrid"
columns = 2

[node name="Spacer" type="Control" parent="Page/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Footer" type="HBoxContainer" parent="Page/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RowBox"

[node name="Hint" type="Label" parent="Page/Column/Footer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"MuteLabel"
text = "Click to choose · the setup is remembered"

[node name="StartButton" type="Button" parent="Page/Column/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BigPrimaryButton"
text = "Play"
icon = ExtResource("chip")
