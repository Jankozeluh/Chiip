[node name="Body" type="MarginContainer" parent="Page/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Overview" type="HBoxContainer" parent="Page/Column/Body"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
