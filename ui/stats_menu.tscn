mouse_filter = 2
theme_type_variation = &"SettingsColumn"

[node name="Header" type="HBoxContainer" parent="Page/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RowBox"

[node name="TitleBox" type="Control" parent="Page/Column/Header"]
