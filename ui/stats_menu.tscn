[gd_scene format=3]

[ext_resource type="Script" path="res://ui/stats_menu.gd" id="menu_script"]

[node name="StatsMenu" type="CanvasLayer"]
process_mode = 3
layer = 7
visible = false
script = ExtResource("menu_script")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_type_variation = &"InkPanel"

[node name="Page" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"PageMargin"

[node name="Column" type="VBoxContainer" parent="Page"]
