[gd_scene format=3]

[ext_resource type="Script" path="res://ui/lobby_menu.gd" id="lobby_script"]
[ext_resource type="Texture2D" path="res://assets/ui/chip.png" id="chip"]

[node name="LobbyMenu" type="CanvasLayer"]
layer = 2
visible = false
script = ExtResource("lobby_script")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"InkPanel"

[node name="Page" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"PageMargin"

[node name="Column" type="VBoxContainer" parent="Page"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PageColumn"

[node name="Header" type="HBoxContainer" parent="Page/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RowBox"

[node name="TitleTrim" type="MarginContainer" parent="Page/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"TitleTrim"

[node name="Title" type="Label" parent="Page/Column/Header/TitleTrim"]
