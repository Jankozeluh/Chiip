[gd_scene format=3]

[ext_resource type="Script" path="res://ui/dev_console.gd" id="console_script"]

[sub_resource type="SystemFont" id="mono_font"]
font_names = PackedStringArray("Menlo", "Monaco", "Courier New", "monospace")

[node name="DevConsole" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("console_script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
custom_minimum_size = Vector2(0, 480)
theme_type_variation = &"ConsolePanel"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_type_variation = &"PanelMargin"

[node name="Box" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_type_variation = &"ContentBox"

[node name="Output" type="Label" parent="Panel/Margin/Box"]
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = SubResource("mono_font")
vertical_alignment = 2
clip_text = true

[node name="Input" type="LineEdit" parent="Panel/Margin/Box"]
layout_mode = 2
theme_override_fonts/font = SubResource("mono_font")
placeholder_text = "type a command, e.g. help"
