offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = 292.0
theme_override_fonts/font = SubResource("mono_font")
theme_override_font_sizes/font_size = 16
vertical_alignment = 2

[node name="Input" type="LineEdit" parent="Panel"]
anchor_right = 1.0
offset_left = 16.0
offset_top = 300.0
offset_right = -16.0
offset_bottom = 332.0
theme_override_fonts/font = SubResource("mono_font")
