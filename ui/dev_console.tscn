[gd_scene format=3]

[ext_resource type="Script" path="res://ui/dev_console.gd" id="console_script"]

[sub_resource type="StyleBoxFlat" id="panel_style"]
bg_color = Color(0.05, 0.06, 0.07, 0.9)
border_width_bottom = 2
border_color = Color(0.85, 0.48, 0.16, 1)

[sub_resource type="SystemFont" id="mono_font"]
font_names = PackedStringArray("Menlo", "Monaco", "Courier New", "monospace")

[node name="DevConsole" type="CanvasLayer"]
layer = 10
script = ExtResource("console_script")

[node name="Panel" type="Panel" parent="."]
