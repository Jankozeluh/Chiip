[gd_scene format=3]

[ext_resource type="Script" path="res://ui/scoreboard.gd" id="scoreboard_script"]
[ext_resource type="PackedScene" path="res://ui/scoreboard_table.tscn" id="table_scene"]

[node name="Scoreboard" type="CanvasLayer"]
process_mode = 3
layer = 3
visible = false
script = ExtResource("scoreboard_script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -440.0
offset_top = 64.0
offset_right = 440.0
offset_bottom = 64.0
grow_horizontal = 2
mouse_filter = 2
theme_type_variation = &"OverlayPanel"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PanelMargin"

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ContentBox"

[node name="HeaderMargin" type="MarginContainer" parent="Panel/Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HeaderMargin"

[node name="Header" type="HBoxContainer" parent="Panel/Margin/Content/HeaderMargin"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ScoreRow"

[node name="YourTrim" type="MarginContainer" parent="Panel/Margin/Content/HeaderMargin/Header"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"TitleTrim"

[node name="YourScore" type="Label" parent="Panel/Margin/Content/HeaderMargin/Header/YourTrim"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FriendlyScoreLabel"
text = "0"

[node name="Lines" type="VBoxContainer" parent="Panel/Margin/Content/HeaderMargin/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"ScoreLines"

[node name="ModeLabel" type="Label" parent="Panel/Margin/Content/HeaderMargin/Header/Lines"]
unique_name_in_owner = true
layout_mode = 2
text = "Team Deathmatch"
horizontal_alignment = 1

[node name="ClockLabel" type="Label" parent="Panel/Margin/Content/HeaderMargin/Header/Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Round 1"
horizontal_alignment = 1

[node name="EnemyTrim" type="MarginContainer" parent="Panel/Margin/Content/HeaderMargin/Header"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"TitleTrim"

[node name="EnemyScore" type="Label" parent="Panel/Margin/Content/HeaderMargin/Header/EnemyTrim"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"EnemyScoreLabel"
text = "0"

[node name="Table" parent="Panel/Margin/Content" instance=ExtResource("table_scene")]
unique_name_in_owner = true
show_money = true
layout_mode = 2
