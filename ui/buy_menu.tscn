[gd_scene format=3]

[ext_resource type="Script" path="res://ui/buy_menu.gd" id="menu_script"]

[node name="BuyMenu" type="CanvasLayer"]
process_mode = 3
layer = 4
visible = false
script = ExtResource("menu_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.62)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_type_variation = &"ModalPanel"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_type_variation = &"PanelMarginWide"

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_type_variation = &"ContentBox"

[node name="TopRow" type="HBoxContainer" parent="Panel/Margin/Content"]
layout_mode = 2
theme_type_variation = &"FormRow"

[node name="Title" type="Label" parent="Panel/Margin/Content/TopRow"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Buy"

[node name="Money" type="Label" parent="Panel/Margin/Content/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BrightLabel"
text = "$ 0"
horizontal_alignment = 2
vertical_alignment = 1

[node name="BuyTime" type="Label" parent="Panel/Margin/Content/TopRow"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Buy time 0 s"
vertical_alignment = 1

[node name="Columns" type="HBoxContainer" parent="Panel/Margin/Content"]
layout_mode = 2
theme_type_variation = &"FormRow"

[node name="Message" type="Label" parent="Panel/Margin/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
horizontal_alignment = 1

[node name="Sound" type="AudioStreamPlayer" parent="."]
process_mode = 3
bus = &"Interface"
