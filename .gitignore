# Godot 4 cache and import data (rebuilt automatically by the editor)
.godot/

# Exported builds
/builds/

# macOS
.DS_Store

# Python caches of the tools (tools/modelgen, tools/concept)
__pycache__/

# Secrets and signing material: never commit these (Godot keeps export passwords in
# export_credentials.cfg, next to export_presets.cfg)
export_credentials.cfg
*.p12
*.pfx
*.keystore
*.jks
.env

# Claude Code: per-machine settings and its working copies of the repository
.claude/worktrees/
.claude/settings.local.json
