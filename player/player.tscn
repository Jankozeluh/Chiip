[gd_scene format=3]

[ext_resource type="PackedScene" path="res://characters/character.tscn" id="character_scene"]
[ext_resource type="PackedScene" path="res://weapons/rifle.tscn" id="rifle_scene"]
[ext_resource type="Script" path="res://player/player_controller.gd" id="controller_script"]

[node name="Player" node_paths=PackedStringArray("weapon") instance=ExtResource("character_scene")]
collision_layer = 2
collision_mask = 5
weapon = NodePath("Head/Camera3D/Weapon")

[node name="Camera3D" type="Camera3D" parent="Head"]
current = true
fov = 73.74

[node name="Weapon" parent="Head/Camera3D" instance=ExtResource("rifle_scene")]

[node name="PlayerController" type="Node" parent="." node_paths=PackedStringArray("camera")]
script = ExtResource("controller_script")
camera = NodePath("../Head/Camera3D")
