[gd_resource type="AudioBusLayout" load_steps=5 format=3]

[sub_resource type="AudioEffectHardLimiter" id="master_limiter"]
resource_name = "HardLimiter"
ceiling_db = -0.5
release = 0.12

[sub_resource type="AudioEffectReverb" id="effects_reverb"]
resource_name = "Reverb"
predelay_msec = 60.0
predelay_feedback = 0.0
room_size = 0.2
damping = 0.8
spread = 0.6
hipass = 0.3
dry = 1.0
wet = 0.0

[sub_resource type="AudioEffectLowPassFilter" id="muffled_low_pass"]
resource_name = "LowPassFilter"
cutoff_hz = 1800.0
resonance = 0.4
db = 1

[sub_resource type="AudioEffectLowPassFilter" id="muffled_heavy_low_pass"]
resource_name = "LowPassFilter"
cutoff_hz = 700.0
resonance = 0.4
db = 1

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &""
bus/0/effect/0/effect = SubResource("master_limiter")
bus/0/effect/0/enabled = true
bus/1/name = &"Effects"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("effects_reverb")
bus/1/effect/0/enabled = true
bus/2/name = &"Muffled"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Effects"
bus/2/effect/0/effect = SubResource("muffled_low_pass")
bus/2/effect/0/enabled = true
bus/3/name = &"MuffledHeavy"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Effects"
bus/3/effect/0/effect = SubResource("muffled_heavy_low_pass")
bus/3/effect/0/enabled = true
bus/4/name = &"Interface"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"Master"
