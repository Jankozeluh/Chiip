[sub_resource type="Resource" id="func_clip"]
script = ExtResource("solid_class")
build_visuals = false
collision_layer = 4
collision_mask = 0
classname = "func_clip"
description = "Invisible wall that stops players and bots, but not bullets or sight: keeps players off roofs and out of gaps (D-123). Any texture; it isn't drawn."
meta_properties = Dictionary[String, Variant]({
"color": Color(0.8, 0.5, 0.8, 1)
})
node_class = "StaticBody3D"

[sub_resource type="Resource" id="trigger_bombsite"]
script = ExtResource("solid_class")
build_visuals = false
collision_layer = 16
collision_mask = 6
script_class = ExtResource("bomb_site_script")
classname = "trigger_bombsite"
description = "Bomb site A or B (D-125): draw one brush over the whole site, from the floor to about 3 m, with its middle on open floor. Set 'site' to A or B. Invisible in the game except for its floating letter."
class_properties = Dictionary[String, Variant]({
"site": "A"
})
class_property_descriptions = Dictionary[String, Variant]({
"site": "Which site: A or B"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(1, 0.82, 0.35, 1)
})
node_class = "Area3D"
node_groups = Array[String](["bomb_sites"])

