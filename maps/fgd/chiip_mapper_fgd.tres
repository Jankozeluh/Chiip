classname = "info_bot_spawn"
description = "Where practice bots appear, and come back after dying (D-142). Not a team spawn and not a player spawn: on a training map the player starts at the scene's Player node. Put 6 or more, away from where the player stands."
meta_properties = Dictionary[String, Variant]({
"color": Color(0.6, 0.6, 0.4, 1),
"size": AABB(-16, -16, 0, 16, 16, 72)
})
node_class = "Marker3D"
node_groups = Array[String](["bot_spawns"])

[sub_resource type="Resource" id="range_target"]
script = ExtResource("point_class")
classname = "range_target"
description = "Training dummy for ranges (D-142): CS hit zones, a floating number for every hit and a running total. Origin on the floor; it faces the entity's angle. With a move_distance it walks from side to side, across its angle."
class_properties = Dictionary[String, Variant]({
"title": "",
"move_distance": 0.0,
"move_speed": 2.5
})
class_property_descriptions = Dictionary[String, Variant]({
"title": "Shown over the dummy, e.g. its distance (20 m)",
"move_distance": "How far it walks from side to side, in metres (0 = stands still)",
"move_speed": "Walking speed in m/s (a rifle running: 5.5, walking: 2.5)"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(0.85, 0.6, 0.3, 1),
"size": AABB(-12, -12, 0, 12, 12, 72)
})
scene_file = ExtResource("target_dummy_scene")

[sub_resource type="Resource" id="range_weapon"]
script = ExtResource("point_class")
script_class = ExtResource("weapon_stand_script")
classname = "range_weapon"
description = "A gun stand for training maps only (D-142): the chosen gun floats over a gold ring and comes back a moment after it's taken. Walk over it, or press E to swap. Matches never use it: their guns come from the buy menu and the random map weapons."
class_properties = Dictionary[String, Variant]({
"weapon": {
"Sparrow (pistol)": "pistol",
"Verdict (hand cannon)": "hand_cannon",
"Hornet (SMG)": "smg",
"Breaker (shotgun)": "shotgun",
"Warden (carbine)": "carbine",
"Ram (rifle)": "rifle",
"Heron (sniper)": "sniper",
"Frag": "frag",
"Flashbang": "flashbang",
"Smoke": "smoke"
},
"refill_time": 2.0
})
class_property_descriptions = Dictionary[String, Variant]({
"weapon": ["Which gun", "rifle"],
"refill_time": "Seconds before a taken gun comes back"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(1, 0.78, 0.25, 1),
"size": AABB(-16, -16, 0, 16, 16, 40)
})
node_class = "Node3D"

[sub_resource type="Resource" id="sign_text"]
script = ExtResource("point_class")
script_class = ExtResource("text_sign_script")
classname = "sign_text"
description = "Text in the world, in the pixel font (D-142): distance markers, hints, names. Read from the side the angle points to, or always facing the player with billboard. Write \\n for a new line."
class_properties = Dictionary[String, Variant]({
"text": "TEXT",
"letter_height": 0.3,
"color": Color(0.92, 0.9, 0.82, 1),
"billboard": 0
})
class_property_descriptions = Dictionary[String, Variant]({
"text": "The words on the sign",
"letter_height": "Height of a capital letter, in metres",
"color": "Colour of the letters. Light and plain: no team red or blue",
"billboard": "1: always turns to the player; 0: faces the angle like a sign on a wall"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(0.9, 0.9, 0.8, 1),
"size": AABB(-8, -8, -8, 8, 8, 8)
})
node_class = "Label3D"

[sub_resource type="Resource" id="range_trainer"]
script = ExtResource("point_class")
script_class = ExtResource("range_trainer_script")
classname = "range_trainer"
description = "The aim trainer's pad for ranges (M14, D-207): a gold coin that, when shot, starts a timed run of flick targets in front of whoever shot it (shot again, it stops the run). The balls pop up one at a time at random spots in plain view, 7 to 20 m away, and the score and your best per gun show on screen and in the Stats screen. Put it on a wall or a post off to the side of the shooting lanes (a ball is never put where the pad is in the way), about 1.3 m up; the coin faces the entity's angle."
class_properties = Dictionary[String, Variant]({
"run_time": 30.0,
"target_lifetime": 1.5,
"min_distance": 7.0,
"max_distance": 20.0,
"half_angle": 45.0
})
class_property_descriptions = Dictionary[String, Variant]({
"run_time": "Seconds a run lasts",
"target_lifetime": "Seconds a ball stays up if nobody hits it",
"min_distance": "The nearest a ball appears from the shooter's eyes, in metres",
"max_distance": "The farthest a ball appears, in metres",
"half_angle": "How far to each side of the shooter's starting view a ball can appear, in degrees"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(1, 0.78, 0.25, 1),
"size": AABB(-12, -12, -12, 12, 12, 12)
})
node_class = "Node3D"

[sub_resource type="Resource" id="range_spray_wall"]
script = ExtResource("point_class")
script_class = ExtResource("range_spray_wall_script")
classname = "range_spray_wall"
description = "The spray wall of a range (M14, D-209): draws the pattern of the gun in the player's hand (grey numbered dots, from the first shot) next to the player's own bullet holes (lime dots) on the wall, with the drift and a control percentage on a sign, and a personal best per gun. Put it at the middle of the face of a flat wall, about 3 m wide and 3 m tall, with the angle pointing away from the wall, toward the shooters (like a sign). A small orange plate in the wall's top corner resets it when shot. It needs a plain wall to draw on; it works for one bullet at a time (a shotgun has no pattern)."
class_properties = Dictionary[String, Variant]({
"width": 3.2,
"height": 3.0
})
class_property_descriptions = Dictionary[String, Variant]({
"width": "How wide the wall is, in metres (the marks and the reset plate stay inside it)",
"height": "How tall the wall is, in metres"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(1, 0.78, 0.25, 1),
"size": AABB(-4, -16, -16, 4, 32, 32)
})
node_class = "Node3D"

